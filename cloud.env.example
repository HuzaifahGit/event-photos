# Copy to cloud.env and fill in. Never commit cloud.env.

# R2 (Cloudflare dashboard > R2 > Manage API tokens > Create API token, "Object Read & Write" on this bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=your-bucket

# Public hostnames (replace the domain)
PUBLIC_IMG_BASE=https://img.example.com
PUBLIC_API_BASE=https://api.example.com
GUEST_ORIGIN=https://photos.example.com
PAGES_PROJECT=event-photos
